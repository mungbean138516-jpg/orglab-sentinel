{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orglab.example/schemas/user-risk-report-v1.json",
  "title": "OrgLab Sentinel UserRiskReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "synthesisId", "humanGate", "status", "action", "targetRange", "checklist"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0" },
    "synthesisId": { "type": "string", "minLength": 1 },
    "humanGate": { "const": true },
    "status": { "type": "string", "minLength": 1 },
    "action": { "enum": ["REVIEW_REBALANCE_RANGE", "NO_IMMEDIATE_REBALANCE", "NO_PORTFOLIO_ACTION"] },
    "targetRange": { "type": "string", "minLength": 1 },
    "checklist": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}

